# Supabase project credentials (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only key for privileged operations (seed script, admin
# tasks). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub and LinkedIn sign-in are enabled per-project in the Supabase
# dashboard (Authentication → Providers), not read from this app's env —
# the client ID/secret you create with each provider go in *there*, not
# here. Listed below only as a reference for what to create:
#   GitHub:   github.com/settings/developers → OAuth App
#             callback URL: <your-supabase-url>/auth/v1/callback
#   LinkedIn: linkedin.com/developers → Create app, request "Sign In with
#             LinkedIn using OpenID Connect", same callback URL pattern.
#             This only ever grants name/email/photo — LinkedIn doesn't
#             expose job listings, connections, or messages to apps
#             outside its restricted partner program.

# --- Career Agent (Phases 2-6) ---------------------------------------------
# None of the below are required for Phase 1 (Career Profile, Job Search,
# Job Match, Applications, Interviews, Assessments, Career Analytics) or
# for LinkedIn sign-in / live job search (Arbeitnow, keyless) — those all
# work already. Unset, the remaining Career Hub features show an explicit
# "Connection Required" state rather than pretending to be connected. See
# ARCHITECTURE.md → "Career Agent" for what each phase needs these for.

# AI provider key — required for AI resume tailoring, cover letter
# generation, email drafting, and free-text job-description analysis.
# The deterministic Job Match score (Phase 1) does not need this.
ANTHROPIC_API_KEY=

# Google OAuth app, shared by Gmail (Career Inbox) and Google Calendar
# (interview scheduling). Create one OAuth client in Google Cloud Console
# with both the Gmail and Calendar APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail scopes needed: gmail.readonly, gmail.compose
# Calendar scopes needed: calendar.events

# Optional: an additional job board/aggregator API for more live-search
# coverage than the built-in keyless source (Arbeitnow) provides — e.g.
# Adzuna, Jooble, or USAJobs. Pick one whose terms permit this use.
JOB_BOARD_API_KEY=
