# Supabase project credentials (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: server-only key for privileged operations (seed script, admin
# tasks). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables the GitHub integration (Settings → Integrations).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Career Agent (Phases 2-6) ---------------------------------------------
# None of the below are required for Phase 1 (Career Profile, Job Search,
# Job Match, Applications, Interviews, Assessments, Career Analytics) —
# those work with Supabase alone. Unset, the corresponding Career Hub
# features show an explicit "Connection Required" state rather than
# pretending to be connected. See ARCHITECTURE.md → "Career Agent" for
# what each phase needs these for.

# AI provider key — required for AI resume tailoring, cover letter
# generation, email drafting, and free-text job-description analysis.
# The deterministic Job Match score (Phase 1) does not need this.
ANTHROPIC_API_KEY=

# Google OAuth app, shared by Gmail (Career Inbox) and Google Calendar
# (interview scheduling). Create one OAuth client in Google Cloud Console
# with both the Gmail and Calendar APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail scopes needed: gmail.readonly, gmail.compose
# Calendar scopes needed: calendar.events

# LinkedIn OAuth app (official API only — never automated login/scraping).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: a supported job board/aggregator API for automatic job
# discovery (Job Search → live listings instead of manual entry). No
# specific provider is wired up yet — set this once you've picked one
# whose terms of service permit the integration you're building.
JOB_BOARD_API_KEY=
